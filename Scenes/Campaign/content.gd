   "dialogue": [
    {
     "speaker": "nagi",
     "text": "到啦，哗啦啦魔女镇。船上的行李都在这儿，是你的吧？"
    },
    {
     "speaker": "player",
     "text": "对，谢谢！总算到了，我腿都坐麻了。"
    },
