static func texture(id: String) -> Texture2D:
	return TEXTURES.get(id)

static func from_path(resource_path: String) -> Texture2D:
	var id := resource_path.get_file().get_basename()
	if id in TEXTURES: return TEXTURES[id]
	if resource_path.ends_with(".png"): resource_path = resource_path.trim_suffix(".png") + ".aseprite"
	return preload("res://Art/Source/aseprite_source.gd").texture(resource_path)
