 "intro": [
  {
   "title": "雾港的后厨",
   "line": "小女巫从小在雾港旅店的后厨帮忙。每天做一大锅饭，却总是她一个人在厨房吃。",
   "scene": "kitchen"
  },
  {
   "title": "写着名字的信",
   "line": "一个下雨的晚上，一封信落在洗碗台上。收信人是她，却没写谁寄的。信里问：今年能来一起吃顿饭吗？",
   "scene": "letter"
  },
  {
   "title": "半箱锅子",
   "line": "信里还附着一本旧食谱。她收拾好衣服和锅子，头一回独自出远门，去找信里说的小镇。",
   "scene": "road"
  },
  {
   "title": "熄灯的小镇",
   "line": "哗啦啦魔女镇的月环已经很久没亮了。季节照常变，田却荒着，食堂也关了门，大家很少再一起吃饭。",
   "scene": "town"
  },
  {
   "title": "等她的门",
   "line": "月芽农场的小屋没锁门。她放下箱子，松了口气：总算到了，以后也许就住这儿了。",
   "scene": "home"
  }
 ],
