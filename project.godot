; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/is_live_update_enabled=false

[application]

config/name="哗啦啦魔女镇"
run/main_scene="res://Scenes/MainMenu/startup_notice.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ArtSources="*res://Art/Source/art_sources.gd"
WalalaFmod="*res://Sounds/Walala/fmod_runtime.gd"
Localization="*res://Localization/localization.gd"
InputBindings="*res://Scenes/Input/input_bindings.gd"
ControllerInput="*res://Scenes/Input/controller_input.gd"
WitchCursor="*res://Scenes/UI/mouse_cursor.gd"
SceneTransition="*res://Scenes/UI/scene_transition.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/walala_aseprite/plugin.cfg", "res://addons/walala_fmod/plugin.cfg", "res://addons/walala_localization/plugin.cfg")

[gui]

theme/custom="res://Art/Fonts/FusionPixel/pixel_theme.tres"

